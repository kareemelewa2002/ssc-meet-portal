# =============================================================================
# E2E test instance — DISPOSABLE. Never point this at the real project.
# =============================================================================
# Playwright loads this file AFTER .env.local and overrides it, then resets the
# database to supabase/seed-demo.sql before the suite runs (e2e/global-setup.ts).
#
# seed-demo.sql is destructive: it rebuilds Vol. 1 heats/lanes/results and
# upserts every demo account. Both variables below MUST describe the SAME
# instance — global setup refuses to run otherwise, because resetting one
# database while testing another is not isolation.
#
# -----------------------------------------------------------------------------
# Option A — local stack (needs Docker running + the Supabase CLI)
# -----------------------------------------------------------------------------
#   brew install supabase/tap/supabase
#   supabase start          # prints API URL, anon key and DB URL
#
# The CLI's defaults are fixed and identical on every machine:
#
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key printed by `supabase start`>
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# SUPABASE_SERVICE_ROLE_KEY=<service_role key printed by `supabase start`>
#
# The service role key is REQUIRED, not optional, for any spec that sets up
# or verifies a HIDDEN volume's state (e.g. e2e/11-unannounced-volume.spec.ts,
# e2e/12-publish-toggle.spec.ts). meet_volumes' "public read" RLS policy
# genuinely restricts unpublished rows now, so those specs' own precondition
# checks cannot read them with the anon key either — without this key they
# silently SKIP instead of running, which is a coverage gap that looks like a
# clean run.
#
# -----------------------------------------------------------------------------
# Option B — a second (free) Supabase cloud project used only for tests
# -----------------------------------------------------------------------------
# Project Settings → API for the first two, → Database → Connection string
# (URI) for the third.
#
# NEXT_PUBLIC_SUPABASE_URL=https://<test-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<test project anon key>
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<test-ref>.supabase.co:5432/postgres
#
# A cloud project whose name/ref contains none of "test", "staging" or "dev"
# is refused by scripts/reset-test-db.ts unless you also set
# ALLOW_NON_TEST_DB=1 — that guard exists to stop a paste of the production
# connection string wiping real meet data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_DB_URL=

# Leave EMPTY. .env.local pins the live project's Skins event UUID, and
# resolveSkinsEventId() trusts any well-formed UUID — against a fresh database
# that id does not exist, and the Skins boards silently never load. Empty falls
# back to the `events.is_skins = true` lookup.
NEXT_PUBLIC_SKINS_EVENT_ID=
