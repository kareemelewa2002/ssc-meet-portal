# ---------------------------------------------------------------------------
# Public — safe to expose, shipped to the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SKINS_EVENT_ID=your-skins-event-uuid

# ---------------------------------------------------------------------------
# Server only — NEVER prefix these with NEXT_PUBLIC_.
#
# lib/supabase/service.ts imports "server-only", so a client component that
# reaches for these fails the build rather than shipping them to a browser.
# ---------------------------------------------------------------------------

# Bypasses row level security completely. Read from the Supabase dashboard
# under Project Settings > API. Used by /api/notifications/dispatch (to read
# email_outbox, which no user is allowed to read) and by the hold sweep.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend. Without this, notices still queue in public.email_outbox and drain
# the moment a key appears — nothing is lost in the meantime.
RESEND_API_KEY=

# Leave unset to send from onboarding@resend.dev, which Resend delivers ONLY
# to the account owner's own address. Set this to an address on a domain you
# have verified in Resend (SPF + DKIM DNS records) before real athletes can
# receive anything.
RESEND_FROM_EMAIL=

# Shared secret for /api/cron/process-expired-holds. The endpoint refuses every
# request when this is unset, rather than defaulting to open. Not needed if you
# rely on pg_cron, which drives the same sweep from inside Postgres.
CRON_SECRET=
